 static void esp32_gpio_reset_hold(Object *obj, ResetType type)
 {
+    Esp32GpioState *s = ESP32_GPIO(obj);
+
+    s->out = 0;
+    s->enable = 0;
+    s->status = 0;
+    memset(s->pin, 0, sizeof(s->pin));
+    memset(s->misc, 0, sizeof(s->misc));
+    s->button_pressed = false;
+    s->btn_done = 0;
+    s->rng = s->btn_seed ? s->btn_seed : 0x9E3779B97F4A7C15ULL;
+    s->in = esp32_gpio_pad_levels(s);
+    if (s->btn_timer && s->btn_count) {
+        timer_mod(s->btn_timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + s->btn_start_ms);
+    }
 }
 
 static void esp32_gpio_realize(DeviceState *dev, Error **errp)
 {
+    Esp32GpioState *s = ESP32_GPIO(dev);
+
+    s->btn_timer = timer_new_ms(QEMU_CLOCK_VIRTUAL, esp32_gpio_btn_tick, s);
+    if (s->trace_path && *s->trace_path) {
+        s->trace = fopen(s->trace_path, "w");
+        if (!s->trace) {
+            error_setg(errp, "esp32.gpio: cannot open trace file %s", s->trace_path);
+            return;
+        }
+        setvbuf(s->trace, NULL, _IOLBF, 0);
+        fprintf(s->trace, "t_ns,gpio,level\n");
+    }
 }
 
