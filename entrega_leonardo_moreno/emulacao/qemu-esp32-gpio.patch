+/* xorshift64*: deterministic press schedule for a given seed */
+static uint32_t esp32_gpio_rand(Esp32GpioState *s, uint32_t lo, uint32_t hi)
+{
+    s->rng ^= s->rng >> 12;
+    s->rng ^= s->rng << 25;
+    s->rng ^= s->rng >> 27;
+    uint64_t r = s->rng * 0x2545F4914F6CDD1DULL;
+    return hi > lo ? lo + (uint32_t)((r >> 32) % (hi - lo + 1)) : lo;
+}
+
+static void esp32_gpio_btn_tick(void *opaque)
+{
+    Esp32GpioState *s = ESP32_GPIO(opaque);
+    int64_t now = qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL);
+    uint32_t next_ms;
+
+    if (!s->button_pressed) {
+        if (s->btn_done >= s->btn_count) {
+            return;
+        }
+        s->btn_done++;
+        s->button_pressed = true;
+        if (s->btn_short_every && (s->btn_done % s->btn_short_every) == 0) {
+            next_ms = s->btn_short_ms;
+        } else {
+            next_ms = esp32_gpio_rand(s, s->btn_width_min_ms, s->btn_width_max_ms);
+        }
+    } else {
+        s->button_pressed = false;
+        next_ms = esp32_gpio_rand(s, s->btn_gap_min_ms, s->btn_gap_max_ms);
+    }
+    esp32_gpio_update(s);
+    timer_mod(s->btn_timer, now + next_ms);
+}
