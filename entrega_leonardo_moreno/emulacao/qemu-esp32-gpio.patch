+enum {
+    INT_DISABLE = 0,
+    INT_POSEDGE = 1,
+    INT_NEGEDGE = 2,
+    INT_ANYEDGE = 3,
+    INT_LOW_LEVEL = 4,
+    INT_HIGH_LEVEL = 5,
+};
+
+static uint32_t esp32_gpio_pad_levels(Esp32GpioState *s)
+{
+    uint32_t level = (s->out & s->enable) | (s->ext_level & ~s->enable);
+
+    if (s->jumper_src >= 0 && s->jumper_dst >= 0 &&
+        (s->enable & BIT(s->jumper_src)) && !(s->enable & BIT(s->jumper_dst))) {
+        level &= ~BIT(s->jumper_dst);
+        level |= ((s->out >> s->jumper_src) & 1) << s->jumper_dst;
+    }
+    if (s->button_pressed && s->btn_pin >= 0 && !(s->enable & BIT(s->btn_pin))) {
+        level &= ~BIT(s->btn_pin);   /* button to GND, active low */
+    }
+    return level;
+}
+
+static uint32_t esp32_gpio_int_mask(Esp32GpioState *s, uint32_t ena_bit)
+{
+    uint32_t mask = 0;
 
+    for (int i = 0; i < 32; i++) {
+        if (FIELD_EX32(s->pin[i], GPIO_PIN0, INT_ENA) & ena_bit) {
+            mask |= BIT(i);
+        }
+    }
+    return mask;
+}
+
+static void esp32_gpio_update(Esp32GpioState *s)
+{
+    uint32_t new_in = esp32_gpio_pad_levels(s);
+    uint32_t changed = new_in ^ s->in;
+
+    for (int i = 0; i < 32; i++) {
+        uint32_t bit = BIT(i);
+        bool hi = new_in & bit;
+
+        switch (FIELD_EX32(s->pin[i], GPIO_PIN0, INT_TYPE)) {
+        case INT_POSEDGE:
+            if ((changed & bit) && hi) {
+                s->status |= bit;
+            }
+            break;
+        case INT_NEGEDGE:
+            if ((changed & bit) && !hi) {
+                s->status |= bit;
+            }
+            break;
+        case INT_ANYEDGE:
+            if (changed & bit) {
+                s->status |= bit;
+            }
+            break;
+        case INT_LOW_LEVEL:
+            if (!hi) {
+                s->status |= bit;
+            }
+            break;
+        case INT_HIGH_LEVEL:
+            if (hi) {
+                s->status |= bit;
+            }
+            break;
+        default:
+            break;
+        }
+    }
+
+    if (s->trace && (changed & s->trace_mask)) {
+        int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        for (int i = 0; i < 32; i++) {
+            if (changed & s->trace_mask & BIT(i)) {
+                fprintf(s->trace, "%" PRId64 ",%d,%d\n", now, i, (new_in >> i) & 1);
+            }
+        }
+    }
+
+    s->in = new_in;
+    qemu_set_irq(s->irq, (s->status & esp32_gpio_int_mask(s, ESP32_GPIO_INT_ENA_PRO)) != 0);
+}
 
